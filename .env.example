# ── Solari ────────────────────────────────────────────────────────────────
# API key for cloud stealth browsers. Grab one at https://console.getsolari.com
# Required to run scans and opt-outs.
SOLARI_API_KEY=slr_live_xxxxxxxxxxxxxxxxxxxx

# ── Groq ─────────────────────────────────────────────────────────────────
# API key for the LLM exposure scoring. Grab one at https://console.groq.com
# Required only for the risk-ranking feature; scans/opt-outs work without it.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Optional overrides ───────────────────────────────────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
SOLARI_REGION=us-west
