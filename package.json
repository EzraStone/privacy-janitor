{
  "name": "privacy-janitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "description": "Local-first, open-source data-broker removal agent powered by Solari stealth browsers",
  "scripts": {
    "dev": "node scripts/run-next.mjs dev -H 127.0.0.1",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types scripts/smoke.mts",
    "smoke:store": "node --experimental-strip-types scripts/smoke-store.mts",
    "smoke:security": "node --experimental-strip-types scripts/smoke-security.mts",
    "smoke:workflow": "node --experimental-strip-types scripts/smoke-workflow.mts",
    "smoke:adapters": "node --experimental-strip-types scripts/smoke-adapters.mts",
    "smoke:privacy": "node --experimental-strip-types scripts/smoke-privacy.mts",
    "check:repo": "node --experimental-strip-types scripts/check-repo-data.mts",
    "doctor": "node scripts/run-doctor.mjs",
    "smoke:setup": "node --experimental-strip-types scripts/smoke-setup.mts",
    "smoke:http": "node --experimental-strip-types scripts/smoke-http.mts",
    "smoke:ui": "node --experimental-strip-types scripts/smoke-ui.mts",
    "check": "npm run typecheck && npm run smoke && npm run smoke:store && npm run smoke:security && npm run smoke:workflow && npm run smoke:adapters && npm run smoke:privacy && npm run smoke:setup && npm run check:repo && npm run build && npm run smoke:http && npm run smoke:ui"
  },
  "dependencies": {
    "@solarisdk/browser": "^0.1.3",
    "dotenv": "^17.2.0",
    "groq-sdk": "^1.6.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0"
  }
}
